APP_NAME=Ayelo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production : LOG_STACK=daily, LOG_LEVEL=info, rotation sur LOG_DAILY_DAYS jours (voir infra/.env.prod.example).
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app_dev_only

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Production : instance distincte pour le cache (allkeys-lru) ; vide en local = même instance que REDIS_HOST.
# REDIS_CACHE_HOST=
# REDIS_CONNECT_TIMEOUT=2
# REDIS_READ_WRITE_TIMEOUT=5
# REDIS_READ_TIMEOUT=5
# Etat de securite non evincable (jeton d'age, compteur de reauthentification, consigne de pose). Vide = magasin de cache par
# defaut. Production : SAFETY_STATE_STORE=state (connexion Redis persistante, voir infra/.env.prod.example).
SAFETY_STATE_STORE=
# Cache et file en base ici (aucun service requis en local). La CI exécute aussi la suite avec CACHE_STORE=redis
# (.github/workflows/ci.yml) pour coller à la production.

# Local development writes mail to the log; production uses Resend SMTP (see infra/.env.prod.example and docs/runbooks/email-dns.md).
# Pour envoyer pour de vrai en local : MAIL_MAILER=smtp et MAIL_PASSWORD = clé API Resend (re_...), jamais commitée.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@ayelo.fr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
SANCTUM_EXPIRATION=43200

APP_WEB_URL=http://localhost
# Origines autorisees pour le CORS (origines completes separees par des virgules, jamais de joker). Vide : origine de APP_WEB_URL.
CORS_ALLOWED_ORIGINS=
# Apercu web local uniquement (docs/runbooks/apercu-local.md) : origines du navigateur de dev, ex. http://localhost:8089.
# Sans effet hors APP_ENV=local ; laisser vide partout ailleurs.
CORS_DEV_ORIGINS=
# Operateur de la console (staff:create, staff:reset-2fa) : identite tracee dans le journal d'audit ; obligatoire en production.
STAFF_OPERATOR=
# Langue du back-office : fr (defaut) ou en.
ADMIN_LOCALE=fr
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=false
# REVERB_APP_MAX_CONNECTIONS=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
MEDIA_ENDPOINT=
MEDIA_BUCKET=
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
MEDIA_AUTO_APPROVE=false
MEDIA_REGION=auto
MEDIA_SIGN_UPLOAD_HEADERS=false
# MEDIA_ISOLATE_PROCESSING=true
# MEDIA_PROCESS_TIMEOUT=10
# MEDIA_PROCESS_MEMORY_LIMIT=256M

REVENUECAT_WEBHOOK_SECRET=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Proxys de confiance (CIDR, séparés par des virgules) ; vide = aucun. Ex. réseau Docker de Caddy.
TRUSTED_PROXIES=

# Conservation et politiques (valeurs par défaut du code ; voir infra/.env.prod.example pour les explications)
RETENTION_REPORT_DETAILS_DAYS=365
RETENTION_SANCTION_REASON_DAYS=365
MAX_SESSIONS_PER_USER=10
UNVERIFIED_RECLAIM_HOURS=24
OAUTH_REQUIRE_NONCE=false
OAUTH_REAUTH_MAX_AGE=600
OAUTH_LOGIN_MAX_AGE=600
DISCOVERY_DAILY_LIKES_FREE=50
# Fraîcheur de la découverte : n'afficher que les profils actifs depuis N jours (vide = pas de filtre)
DISCOVERY_ACTIVE_WITHIN_DAYS=
PUSH_MESSAGE_PREVIEW=false
ADMIN_DAILY_CREDIT_CAP=2000
ADMIN_DAILY_PREMIUM_DAYS_CAP=366

# Suivi d'erreurs facultatif (aucun paquet installé : voir docs/runbooks/observabilite.md)
SENTRY_LARAVEL_DSN=
