# Reverse proxy : TLS automatique (Let's Encrypt). Les domaines viennent des variables d'environnement.
# Non exécuté sur le poste de développement : valider avec `caddy validate --config /etc/caddy/Caddyfile` sur le serveur.
{
	email {$ACME_EMAIL}
}

# En-têtes communs à tous les hôtes (revue F-17). Importé dans chaque bloc.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-X-Powered-By
	}
}

# Liste blanche d'IP du panneau d'administration (revue N-01 / F-17).
# ADMIN_ALLOWED_IPS = plages CIDR séparées par des espaces (ex. "203.0.113.10/32 198.51.100.0/24").
# Valeur par défaut = plage de documentation 192.0.2.0/24 : personne n'est autorisé tant que la variable n'est pas
# renseignée (échec fermé). Si la variable est présente mais VIDE, Caddy refuse de démarrer : c'est voulu.
# remote_ip = adresse du pair TCP. Valable car Caddy est en bordure (aucun CDN devant). Si un CDN est ajouté un jour,
# déclarer ses plages dans `servers { trusted_proxies static ... }` et remplacer `remote_ip` par `client_ip`.
(admin_ip_allowlist) {
	@admin_blocked not remote_ip {$ADMIN_ALLOWED_IPS:192.0.2.0/24}
	respond @admin_blocked 403
}

# En-têtes du site de présentation (docs/runbooks/site-public.md). `security_headers` fournit déjà HSTS, nosniff, X-Frame-Options,
# Referrer-Policy no-referrer, etc. Le site de présentation n'a ni script externe, ni police, ni image tierce : CSP default-src 'self'.
# connect-src et form-action n'autorisent que l'API, pour les deux formulaires de suppression de compte
# (backend/config/cors.php n'ouvre CORS que pour ces routes et seulement à l'origine du site de présentation).
(web_headers) {
	import security_headers
	header Content-Security-Policy "default-src 'self'; connect-src 'self' https://{$API_DOMAIN}; form-action 'self' https://{$API_DOMAIN}; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
}

# API REST
{$API_DOMAIN} {
	root * /var/www/html/public
	encode zstd gzip
	# Le panneau et ses routes Livewire ne sont JAMAIS servis sur le domaine de l'API.
	@panel path /admin /admin/* /livewire /livewire/* /filament /filament/*
	respond @panel 404
	# Liste blanche (revue S9) : seuls /api/* et /up sont servis. Tout le reste, y compris /index.php/... (qui
	# contournerait la liste noire ci-dessus), répond 404.
	@not_api not path /api/* /up
	respond @not_api 404
	import security_headers
	# API JSON : aucune ressource active n'est jamais chargée depuis une réponse de l'API.
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
	php_fastcgi app:9000
	file_server
	request_body {
		max_size 12MB
	}
}

# WebSocket (Reverb). Le conteneur reverb n'est joignable que par ce proxy (aucun port publié).
{$WS_DOMAIN} {
	import security_headers
	reverse_proxy reverb:8080
}

# Administration (Filament) : domaine séparé de l'API, restreint par IP (ADMIN_ALLOWED_IPS), jamais indexé.
{$ADMIN_DOMAIN} {
	root * /var/www/html/public
	encode zstd gzip
	import admin_ip_allowlist
	# L'API n'est servie que sur son domaine (revue N-01) : ici /api et /up répondent 404.
	@api_ici path /api /api/* /up
	respond @api_ici 404
	import security_headers
	header {
		# Pas de cache des pages d'administration (données personnelles) ni d'indexation.
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
		# CSP adaptée à Filament 4 / Livewire / Alpine : scripts et styles en ligne et 'unsafe-eval' (Alpine, build
		# standard) sont nécessaires, donc la CSP limite surtout les origines : pas d'iframe, pas de <base>,
		# pas d'objet, formulaires et XHR vers soi-même uniquement. Les polices par défaut de Filament viennent de
		# fonts.bunny.net. img-src https: permet les aperçus de médias servis par URL présignée du stockage objet.
		# À resserrer (nonces) si Filament le permet un jour ; à vérifier dans un vrai navigateur (console CSP).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; font-src 'self' https://fonts.bunny.net data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	request_body {
		max_size 2MB
	}
	php_fastcgi app:9000
	file_server
}

# Site de présentation : pages HTML de web/ remplies par l'application avec les mentions légales publiées depuis le panneau
# d'administration (route interne /_site, backend/app/Http/Controllers/SiteController.php), repli sur les fichiers statiques.
# Le dossier web/ du dépôt est monté en lecture seule sur /srv/web (docker-compose.prod.yml), dans ce conteneur et dans `app`.
# Ce bloc a été essayé sur le serveur (Caddy 2.8 en conteneur isolé) avant la mise en production ; voir
# docs/runbooks/site-public.md (section « Mentions légales saisies depuis le panneau d'administration »).
{$WEB_DOMAIN} {
	root * /srv/web
	encode zstd gzip
	import web_headers

	# Jamais servis : le dossier tools/ (scripts de génération, catalogue des champs), .git, et la route interne /_site (elle n'est
	# atteinte que par la réécriture plus bas). security.txt est un MODÈLE (« NE PAS PUBLIER TEL QUEL », contact en example.invalid) :
	# masqué tant que le propriétaire n'a pas renseigné de vraie adresse. `handle` (et non `respond`) : les blocs `handle` passent
	# avant les directives `respond` dans l'ordre de Caddy, un `respond` serait masqué par le `handle @pages`.
	@private path /tools /tools/* /.git /.git/* /.well-known/security.txt /_site /_site/*
	handle @private {
		respond 404
	}

	# Les liens de la version anglaise sont relatifs : /en doit se terminer par une barre oblique.
	redir /en /en/ permanent

	# Page dont l'URL contient un jeton : jamais mise en cache.
	@confirm path /confirm-deletion /confirm-deletion.html /en/confirm-deletion /en/confirm-deletion.html
	header @confirm Cache-Control "no-store"

	# Pages HTML : celles qui existent dans web/ (/, /legal/terms, /legal/terms.html, /en/...) vont à l'application ; ressources,
	# 404.html et toute adresse inconnue restent servies par Caddy (404.html pour les adresses inconnues, comme avant).
	@pages {
		not path /assets/* /favicon.svg /robots.txt /404.html
		file {
			root /srv/web
			try_files {path} {path}.html {path}/index.html
		}
	}
	handle @pages {
		# Transport FastCGI explicite, pas `php_fastcgi` : celui-ci cherche index.php sous le root du SITE (/srv/web) et, ne le
		# trouvant pas, ne transmet rien (réponse 200 vide, constatée en production le 2026-11-20). `split .php` est obligatoire
		# (sans lui PHP-FPM répond « Access denied. »).
		rewrite * /index.php
		reverse_proxy app:9000 {
			transport fastcgi {
				root /var/www/html/public
				split .php
				# Caddy transmet à PHP l'URI D'ORIGINE (REQUEST_URI) : on impose l'adresse interne que la route attend, et un marqueur
				# que la route exige (sans lui, 404) : ce domaine n'ouvre ainsi aucune autre route de l'application (/api, /up, /livewire).
				env REQUEST_URI /_site{http.request.orig_uri.path}
				env SITE_PROXY 1
			}
			# Toute réponse en échec de l'application (4xx, 5xx) : repli statique (handle_errors, plus bas). Application arrêtée ou
			# injoignable (502/503/504) : même repli.
			@app_failed status 4xx 5xx
			handle_response @app_failed {
				error "application indisponible" 502
			}
		}
	}

	# Ressources (feuilles de style, polices, images, scripts, robots.txt) et page 404.
	handle {
		header Cache-Control "public, max-age=3600"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		# Application arrêtée, injoignable ou en échec : la page statique correspondante, avec ses marqueurs « À COMPLÉTER »,
		# en 200 (dans un gestionnaire d'erreurs file_server reprendrait sinon le code de l'erreur, 502).
		@app_down expression {err.status_code} >= 500
		handle @app_down {
			root * /srv/web
			import web_headers
			# Page à jeton dans l'URL : jamais de cache, même en repli. Constaté par infra/scripts/caddy-routage-test.sh le 2026-11-22 :
			# (1) ici l'adresse a déjà été réécrite en /index.php, donc `@confirm` (défini plus haut sur `path`) ne correspond plus : on
			# compare l'adresse d'origine ; (2) Caddy applique une directive `header` SANS détecteur après celles qui en ont un, quelle que
			# soit leur place dans le fichier : l'en-tête général serait venu écraser `no-store`, d'où le préfixe `?` (poser seulement si absent).
			@confirm_orig expression `{http.request.orig_uri.path} in ['/confirm-deletion', '/confirm-deletion.html', '/en/confirm-deletion', '/en/confirm-deletion.html']`
			header @confirm_orig Cache-Control "no-store"
			header ?Cache-Control "public, max-age=60"
			try_files {http.request.orig_uri.path} {http.request.orig_uri.path}.html {http.request.orig_uri.path}/index.html
			file_server {
				status 200
			}
		}
		# 404 : la page web/404.html, avec le code 404 conservé.
		handle {
			root * /srv/web
			rewrite * /404.html
			import web_headers
			file_server
		}
	}
}

# www -> domaine nu. Production : WEB_DOMAIN=ayelo.fr, donc ce bloc sert www.ayelo.fr (enregistrement A vers le serveur, comme
# les autres hôtes) et redirige vers https://ayelo.fr. Si WEB_DOMAIN commence déjà par « www. » (préproduction), ce bloc
# vise « www.www.… » : sans effet, mais Caddy y tentera un certificat ; ne pas le conserver dans ce cas.
www.{$WEB_DOMAIN} {
	import security_headers
	redir https://{$WEB_DOMAIN}{uri} permanent
}
