# Copier en infra/.env.prod (hors dépôt, droits 600) et remplir. AUCUNE valeur réelle dans ce fichier d'exemple.
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.invalid
APP_WEB_URL=https://www.example.invalid
# Origines autorisées à appeler la suppression de compte depuis un navigateur (CORS, backend/config/cors.php). Origines complètes
# séparées par des virgules. Vide : l'origine de APP_WEB_URL. Jamais de joker.
CORS_ALLOWED_ORIGINS=
API_DOMAIN=api.example.invalid
# Site de présentation statique (web/) : mêmes règles DNS que API_DOMAIN. APP_WEB_URL doit être https://<WEB_DOMAIN> (lien des e-mails
# de suppression de compte, et unique origine CORS autorisée). Seul Caddy reçoit WEB_DOMAIN.
WEB_DOMAIN=www.example.invalid
WS_DOMAIN=ws.example.invalid
ADMIN_DOMAIN=admin.example.invalid
# Plages CIDR autorisées pour le panneau d'administration, séparées par des espaces. À REMPLACER par vos IP fixes
# (VPN, bureau). 203.0.113.0/24 est une plage de documentation : tant qu'elle reste, personne de réel n'entre.
ADMIN_ALLOWED_IPS=203.0.113.10/32
ACME_EMAIL=
# Réseau Docker interne où se trouve Caddy (seul proxy de confiance). Ne jamais mettre 0.0.0.0/0 ni *.
TRUSTED_PROXIES=172.16.0.0/12

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=

REDIS_CLIENT=predis
# Instance « file d'attente + sessions » : AOF everysec, noeviction (docs/runbooks/redis.md).
REDIS_HOST=redis
# Instance « cache + limiteurs » : allkeys-lru, sans persistance. Connexion Laravel `cache` (config/database.php).
REDIS_CACHE_HOST=redis-cache
# Obligatoire : même valeur pour les deux conteneurs redis (docker-compose.prod.yml). Générer une valeur longue aléatoire.
REDIS_PASSWORD=
# Mémoire maximale de chaque instance (lue par docker-compose.prod.yml). noeviction : à saturation Redis refuse les écritures
# au lieu d'effacer des tâches ; surveiller (docs/runbooks/observabilite.md).
REDIS_QUEUE_MAXMEMORY=512mb
REDIS_CACHE_MAXMEMORY=256mb
# Délais de connexion / lecture (secondes) : une panne Redis doit échouer vite.
REDIS_CONNECT_TIMEOUT=2
REDIS_READ_WRITE_TIMEOUT=5
REDIS_READ_TIMEOUT=5
CACHE_STORE=redis
# Etat de securite qui ne doit PAS etre evince (jeton d'age a usage unique, compteur de reauthentification, consigne de pose
# selfie). Valeur de production : `state` = connexion Redis PERSISTANTE `default` (noeviction, AOF), prefixe distinct
# (backend/config/cache.php). Ne jamais pointer vers l'instance cache en allkeys-lru : une eviction rearmerait ces garde-fous.
SAFETY_STATE_STORE=state
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
BROADCAST_CONNECTION=reverb
HASH_DRIVER=argon2id

# Journaux (revue CTO n°1) : fichier quotidien avec rotation dans le volume app-storage, niveau info.
# Les mots de passe, jetons et adresses e-mail sont masqués par le processeur RedactLogs (config/logging.php).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
# Nombre de jours de fichiers de journal conservés (rotation automatique).
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# Suivi d'erreurs : facultatif, désactivé tant que vide (voir docs/runbooks/observabilite.md ; aucun paquet n'est installé).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Processus PHP-FPM (infra/php/php-fpm-pool.conf). Dimensionner avec APP_MEMORY_LIMIT : (mémoire - 256 Mo) / ~60 Mo.
FPM_MAX_CHILDREN=24
FPM_START_SERVERS=6
FPM_MIN_SPARE_SERVERS=4
FPM_MAX_SPARE_SERVERS=10
FPM_MAX_REQUESTS=500
FPM_REQUEST_TERMINATE_TIMEOUT=60s
FPM_SLOWLOG_TIMEOUT=5s
# Limite mémoire du conteneur app (docker-compose.prod.yml) et nombre de workers de la file `default`.
APP_MEMORY_LIMIT=2g
WORKER_REPLICAS=2

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.example.invalid
REVERB_PORT=443
REVERB_SCHEME=https
# Origines WebSocket autorisées (hôtes séparés par des virgules). Vide : hôte de APP_WEB_URL et REVERB_HOST.
REVERB_ALLOWED_ORIGINS=www.example.invalid,ws.example.invalid
# Aucun événement émis par les clients sur les canaux (l'application n'en utilise pas) et limitation de débit active (F-17).
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none
REVERB_APP_RATE_LIMITING_ENABLED=true
# Pub/sub Redis entre instances Reverb : false tant qu'il n'y a qu'un seul conteneur reverb ; true AVANT d'en lancer un second
# (docs/runbooks/dimensionnement.md).
REVERB_SCALING_ENABLED=false
# Plafond de connexions WebSocket simultanées par application (vide = illimité ; le plafond réel est la limite de descripteurs, 65536).
REVERB_APP_MAX_CONNECTIONS=5000

MEDIA_ENDPOINT=
MEDIA_BUCKET=
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
MEDIA_AUTO_APPROVE=false
# Notes vocales et vidéos en conversation : fermées (false) tant que le conteneur `transcode` n'est pas déployé et essayé
# (docs/runbooks/transcode.md). À true seulement après : le contrôle de déploiement vérifie le dossier partagé.
MEDIA_CHAT_AV_ENABLED=false
MEDIA_TRANSCODE_SPOOL=/spool
# Au-delà, le média est refusé (secondes) ; intervalle entre deux regards de la tâche (secondes).
MEDIA_TRANSCODE_TIMEOUT=300
MEDIA_TRANSCODE_POLL=5
MEDIA_REGION=auto
# Lie la taille et le type du fichier à l'URL présignée de dépôt (revue pentest P-07). Laissé à false tant que le vrai bucket
# n'a pas été essayé en préproduction (docs/runbooks/deploiement.md, « Après le premier déploiement ») : le client doit alors
# envoyer exactement le Content-Type annoncé et un corps de la taille déclarée. Passer à true une fois l'essai réussi ;
# `php artisan deploy:preflight` rappelle cet avertissement tant que la valeur est false.
MEDIA_SIGN_UPLOAD_HEADERS=false
# Délais du client de stockage objet, en secondes (connexion, puis réponse totale). Un stockage lent ne doit pas garder un
# processus PHP-FPM jusqu'à FPM_REQUEST_TERMINATE_TIMEOUT.
MEDIA_CONNECT_TIMEOUT=3
MEDIA_HTTP_TIMEOUT=20
# Nouvelles tentatives après un échec transitoire du stockage : (1 + MEDIA_RETRIES) x MEDIA_HTTP_TIMEOUT doit rester sous FPM_REQUEST_TERMINATE_TIMEOUT.
MEDIA_RETRIES=1
# Ré-encodage des images dans un sous-processus PHP isolé (secondes de délai, mémoire du sous-processus).
MEDIA_ISOLATE_PROCESSING=true
MEDIA_PROCESS_TIMEOUT=10
MEDIA_PROCESS_MEMORY_LIMIT=256M

REVENUECAT_WEBHOOK_SECRET=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Révocation du jeton Apple à la suppression d'un compte (exigence d'Apple pour « Se connecter avec Apple »). Vide : aucune
# révocation. Le premier de APPLE_CLIENT_IDS sert d'identifiant. APPLE_PRIVATE_KEY : contenu de la clé .p8, retours à la ligne écrits \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# E-mail transactionnel via Resend SMTP (voir docs/runbooks/email-dns.md).
# Le domaine ayelo.fr doit être vérifié chez Resend avant le premier envoi.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
# Port 587 utilise STARTTLS ; le port 465 utilise TLS implicite.
MAIL_SCHEME=
# Resend exige ce nom d'utilisateur et une clé d'API en mot de passe.
MAIL_USERNAME=resend
# Renseigner une clé d'API Resend limitée à l'envoi. Secret à garder hors du dépôt.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@ayelo.fr
MAIL_FROM_NAME=Ayelo
# Nom annoncé à l'ouverture SMTP.
MAIL_EHLO_DOMAIN=ayelo.fr

# Webhooks de rebond et de plainte (POST /api/v1/webhooks/mail). Deux voies, une seule suffit ; vide = cette voie répond 401.
#  - Resend : « signing secret » du webhook (whsec_...), affiché à sa création. Resend signe avec Svix et n'ajoute aucun en-tête secret.
MAIL_WEBHOOK_SVIX_SECRET=
#  - Postmark : secret long et aléatoire (openssl rand -hex 32), à recopier dans l'en-tête X-Mail-Webhook-Secret du webhook.
MAIL_WEBHOOK_SECRET=

# Politiques du produit : les valeurs ci-dessous sont les valeurs par défaut du code, écrites ici pour que chaque choix soit explicite.
# CONSERVATION (choix juridiques : à faire valider par le juriste, voir docs/DECISIONS-PROPRIETAIRE.md).
# Jours avant effacement du texte libre des signalements et des motifs de sanction.
RETENTION_REPORT_DETAILS_DAYS=365
RETENTION_SANCTION_REASON_DAYS=365
# Jours sans aucune activité après lesquels un compte créé par e-mail et JAMAIS vérifié est anonymisé (accounts:purge-unverified, 03:30).
# Valeur initiale à faire valider avec la matrice juridique ; ne touche jamais un compte vérifié, social, payant ou signalé.
RETENTION_UNVERIFIED_ACCOUNT_DAYS=30
# Âge, sessions, comptes non vérifiés
MAX_SESSIONS_PER_USER=10
UNVERIFIED_RECLAIM_HOURS=24
TYPED_EMAIL_REFUSAL_DAYS=30
# OAuth (Google / Apple) : nonce exigé et ancienneté maximale de la réauthentification (secondes)
OAUTH_REQUIRE_NONCE=false
OAUTH_REAUTH_MAX_AGE=600
# Produit
DISCOVERY_DAILY_LIKES_FREE=50
# Fraîcheur de la découverte : n'afficher que les profils actifs depuis N jours (vide = pas de filtre)
DISCOVERY_ACTIVE_WITHIN_DAYS=
# Notifications push : true = aperçu de 80 caractères du message (décision produit, vie privée) ; false = texte générique.
PUSH_MESSAGE_PREVIEW=false
# Plafonds quotidiens d'attribution manuelle depuis le panneau d'administration
ADMIN_DAILY_CREDIT_CAP=2000
ADMIN_DAILY_PREMIUM_DAYS_CAP=366
# Operateur de la console : identite de la personne qui lance staff:create / staff:reset-2fa (journal d'audit). OBLIGATOIRE en
# production pour ces commandes, par exemple prenom.nom.
STAFF_OPERATOR=
# Langue du back-office : fr (defaut) ou en. Chaque personne peut choisir la sienne dans son profil (prioritaire).
ADMIN_LOCALE=fr
# Bandeau du panneau hors production (par exemple « Preproduction ») ; ignore en production, ou aucun bandeau n'est affiche.
ADMIN_ENVIRONMENT_LABEL=
# Minutes pendant lesquelles un signalement « pris » verrouille sa decision (puis il redevient libre).
ADMIN_ASSIGNMENT_TTL_MINUTES=60

# Sauvegardes : planification (cron), bucket dédié et clé de chiffrement GPG (destinataire)
BACKUP_TIME_UTC=02:15
BACKUP_RETENTION_DAYS=14
# Sauvegardes mensuelles gardées en plus des quotidiennes (première de chaque mois ; 0 = aucune)
BACKUP_MONTHLY_RETENTION_MONTHS=6
# URL de webhook appelée (POST JSON : hôte, heure UTC, étape) en cas d'échec ; vide = pas d'alerte
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
# OBLIGATOIRE (docker compose refuse de démarrer si vide) : identifiant de la clé publique GPG qui chiffre chaque archive.
BACKUP_GPG_RECIPIENT=
# OBLIGATOIRE : chemin sur l'HÔTE du fichier de clé PUBLIQUE exportée (gpg --armor --export). Monté en lecture seule dans le
# conteneur backup. La clé PRIVÉE ne doit JAMAIS être sur le serveur (docs/runbooks/sauvegardes-chiffrement.md).
BACKUP_GPG_PUBLIC_KEY_PATH=/opt/ayelo/backup-public.asc
