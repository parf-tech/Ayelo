  "colorShared": {
    "light": { "todoBg": "#FDE68A" },
    "dark": { "todoBg": "#5B3A06" }
  },
  "colorRoles": {
    "accent": { "doc": "Mise en avant douce (match, plan choisi). Ne porte jamais seule une information ; le texte onAccent porte le sens." },
    "bg": { "doc": "Fond d'écran." },
    "border": { "doc": "Séparateur décoratif (non exigé à 3:1, WCAG 1.4.11)." },
    "borderStrong": { "doc": "Contour de composant (champ, case, piste d'interrupteur) : >= 3:1 (WCAG 1.4.11). `border` reste pour les séparateurs décoratifs." },
    "danger": { "doc": "Erreur, action destructrice." },
    "disabledBg": { "doc": "Fond d'un composant désactivé." },
    "disabledText": { "doc": "Texte d'un composant désactivé (reste lisible à 4,5:1)." },
    "dislike": { "doc": "Refus (texte, contour, glyphe). Le bouton « Passer » utilise passNeutral." },
    "focusRing": { "doc": "Anneau de focus, 2 pt." },
    "info": { "doc": "Information (bandeau, lien d'aide). Égal à verified dans les trois directions." },
    "like": { "doc": "J'aime (texte, contour, glyphe)." },
    "onAccent": { "doc": "Texte et glyphes sur accent." },
    "onPrimary": { "doc": "Texte et glyphes sur primary (et sur danger)." },
    "overlay": { "doc": "Teinte opaque de fond de modale ; préférer scrim." },
    "passNeutral": { "doc": "Bouton « Passer » neutre : ni rouge ni vert (principe 2, daltonisme)." },
    "primary": { "doc": "Action principale (fond), lien (texte), bulle envoyée." },
    "scrim": { "doc": "Voile semi-transparent derrière une modale ou une feuille (hexadécimal à 8 chiffres, alpha à la fin)." },
    "skeleton": { "doc": "Fond des squelettes et des substituts de photo." },
    "success": { "doc": "Succès." },
    "surface": { "doc": "Cartes, champs, bulles reçues." },
    "text": { "doc": "Texte principal." },
    "textMuted": { "doc": "Texte secondaire, aides, onglets inactifs." },
    "todoBg": { "doc": "Fond du marqueur « à compléter » des pages web (texte text dessus).", "platforms": ["web"] },
    "verified": { "doc": "Badge vérifié." },
    "warning": { "doc": "Avertissement (alerte anti-arnaque contextuelle)." }
  },
  "contrast": {
    "textMin": 4.5,
    "controlMin": 3,
    "text": [
      ["text", "bg"],
      ["text", "surface"],
      ["textMuted", "bg"],
      ["textMuted", "surface"],
      ["textMuted", "skeleton"],
      ["primary", "bg"],
      ["primary", "surface"],
      ["onPrimary", "primary"],
      ["onPrimary", "danger"],
      ["onAccent", "accent"],
      ["like", "bg"],
      ["like", "surface"],
      ["dislike", "bg"],
      ["dislike", "surface"],
      ["verified", "bg"],
      ["verified", "surface"],
      ["info", "bg"],
      ["info", "surface"],
      ["warning", "bg"],
      ["warning", "surface"],
      ["success", "bg"],
      ["success", "surface"],
      ["danger", "bg"],
      ["danger", "surface"],
      ["passNeutral", "bg"],
      ["passNeutral", "surface"],
      ["disabledText", "disabledBg"],
      ["text", "todoBg"]
    ],
    "control": [
      ["borderStrong", "bg"],
      ["borderStrong", "surface"],
      ["focusRing", "bg"],
      ["focusRing", "surface"],
      ["primary", "bg"],
      ["primary", "surface"],
      ["passNeutral", "bg"],
      ["passNeutral", "surface"]
    ],
    "informational": [
      ["accent", "bg"],
      ["border", "bg"]
    ]
  },
  "typography": {
    "fontFamilyWeb": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "title": { "size": 28, "lineHeight": 34, "weight": "bold", "doc": "Titre d'écran." },
      "h2": { "size": 22, "lineHeight": 28, "weight": "semibold", "doc": "Titre de section." },
      "h3": { "size": 18, "lineHeight": 24, "weight": "semibold", "doc": "Sous-titre." },
      "body": { "size": 16, "lineHeight": 24, "weight": "regular", "doc": "Texte courant." },
      "bodySmall": { "size": 14, "lineHeight": 20, "weight": "regular", "doc": "Texte juridique et mentions obligatoires (renouvellement, consentements)." },
      "caption": { "size": 13, "lineHeight": 18, "weight": "regular", "doc": "Légende, aide, horodatage." },
      "label": { "size": 14, "lineHeight": 20, "weight": "medium", "doc": "Étiquette de champ et de contrôle." },
      "captionStrong": { "size": 13, "lineHeight": 18, "weight": "semibold", "doc": "Légende appuyée (statut, badge)." }
    }
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48],
  "borderWidth": { "hairline": 1, "strong": 2 },
  "minTarget": 44,
  "contentWidth": { "app": 560, "web": 760 },
  "elevation": {
    "0": {
      "rn": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 0 }, "shadowOpacity": 0, "shadowRadius": 0, "elevation": 0 },
      "css": "none",
      "doc": "Repos : contour de 1 pt et changement de fond, aucune ombre (direction B)."
    },
    "1": {
      "rn": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 1 }, "shadowOpacity": 0.08, "shadowRadius": 2, "elevation": 1 },
      "css": "0 1px 2px 0 rgb(0 0 0 / 0.08)",
      "doc": "Élément posé : toast."
    },
    "2": {
      "rn": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 4 }, "shadowOpacity": 0.12, "shadowRadius": 8, "elevation": 4 },
      "css": "0 4px 8px 0 rgb(0 0 0 / 0.12)",
      "doc": "Feuille du bas, menu."
    },
    "3": {
      "rn": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 8 }, "shadowOpacity": 0.16, "shadowRadius": 16, "elevation": 8 },
      "css": "0 8px 16px 0 rgb(0 0 0 / 0.16)",
      "doc": "Boîte de dialogue modale."
    }
  },
  "motion": {
    "duration": { "fast": 120, "base": 180, "slow": 300 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "enter": [0, 0, 0, 1],
      "exit": [0.3, 0, 1, 1]
    },
    "easingDoc": {
      "standard": "Déplacement et changement d'état entre deux positions.",
      "enter": "Apparition (décélération).",
      "exit": "Disparition (accélération)."
    },
    "reduceMotion": {
      "rule": "Si le système demande de réduire les animations : plus de translation, d'échelle ni de rebond ; un fondu seul est permis et sa durée est plafonnée.",
      "transform": "none",
      "fadeOnly": true,
      "maxDurationMs": 120
    }
  },
  "zIndex": { "base": 0, "raised": 10, "sticky": 100, "overlay": 200, "modal": 300, "toast": 400 },
  "focus": { "width": 2, "offset": 2, "color": "focusRing" },
  "stateOpacity": { "pressed": 0.8, "hover": 0.92, "disabled": 0.4, "skeleton": 0.45 },
  "iconSize": { "sm": 16, "md": 20, "lg": 24, "xl": 32 },
  "hitSlop": 8
}
