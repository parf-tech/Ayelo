# Copier en .env.local (ignoré par git) puis adapter. Aucune valeur secrète ici :
# les variables EXPO_PUBLIC_* sont INCLUSES dans l'application (ne jamais y mettre de secret).

# URL racine du backend Laravel, SANS /api/v1 (le client ajoute le préfixe).
# - Émulateur Android : http://10.0.2.2:8000
# - Simulateur iOS    : http://localhost:8000
# - Téléphone réel (Expo Go) : http://<IP-de-votre-PC-sur-le-réseau>:8000 ou une URL HTTPS publique
EXPO_PUBLIC_API_URL=

# Temps réel (Laravel Reverb, protocole Pusher). La clé d'application Reverb est publique (jamais le secret).
# Sans ces deux variables, l'application se rafraîchit périodiquement au lieu d'utiliser la socket.
EXPO_PUBLIC_REVERB_KEY=
EXPO_PUBLIC_REVERB_HOST=
EXPO_PUBLIC_REVERB_PORT=
EXPO_PUBLIC_REVERB_SCHEME=

# Achats (RevenueCat) : clés SDK PUBLIQUES par plateforme. Requiert un build de développement (inutilisable dans Expo Go).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Mentions légales (S57) : adresses des textes validés par un juriste. Non configurées = lien masqué.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_COMMUNITY_RULES_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
